# Setup in .env
LLM_BASE_URL=your_llm_base_url
LLM_API_KEY=your_api_key
LLM_MODEL=your_model_of_choice
EMAIL_RECIPIENT=your.recipient@email.example
EMAIL_SENDER=your.sender@gmail.com
EMAIL_SENDER_APP_PASSWORD=your_gmail_app_password
# SMTP values below are for a Gmail sender, adjust for other providers
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
DEV_MODE=false
